# eng/demo.ps1 generates .env with a random local SQL password and pinned images.
# Do not use this placeholder as a password.
SQL_PASSWORD=GENERATE_WITH_ENG_DEMO
SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04
SERVICEBUS_IMAGE=mcr.microsoft.com/azure-messaging/servicebus-emulator:2.0.0
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.400
RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.11
DASHBOARD_IMAGE=mcr.microsoft.com/dotnet/aspire-dashboard:13.5.2
DASHBOARD_PORT=18888
